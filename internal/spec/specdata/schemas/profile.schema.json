{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-spec.invalid/v0/profile.schema.json",
  "title": "Profile (generic layer or per-project overlay)",
  "description": "A profile is the standard routine for one kind of work: sandbox, network, ops and limits. A generic profile (layer 'generic') is owned by the factory. A project overlay (layer 'overlay') extends exactly one generic profile at a pinned version and may only add toolchain, services and network hosts, narrow ops, and set limits. An overlay can never add an op the generic profile does not allow. Profiles and overlays are distributed as signed OCI artifacts; only a signed, merged revision is ever loaded (docs/spec.md).",
  "oneOf": [
    {
      "$ref": "#/$defs/generic"
    },
    {
      "$ref": "#/$defs/overlay"
    }
  ],
  "$defs": {
    "image_ref": {
      "description": "OCI image reference pinned by digest. Tags alone are not accepted.",
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+(:[A-Za-z0-9._-]{1,128})?@sha256:[0-9a-f]{64}$"
    },
    "toolchain_manifest": {
      "description": "Digest of the VM's MANIFEST.sha256: the file that lists the SHA-256 of every pinned toolchain artifact installed in the VM image. For isolation 'vm' it takes the place of image.ref, so a changed toolchain is a changed profile.",
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "sha256"
      ],
      "additionalProperties": false
    },
    "file_ref": {
      "description": "A versioned text file (prompt) pinned by digest.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "host_rule": {
      "description": "One egress allowlist entry. Hosts only: no IP literals, no CIDR.",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "common.schema.json#/$defs/hostname"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "purpose": {
          "$ref": "common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "host",
        "ports",
        "purpose"
      ],
      "additionalProperties": false
    },
    "service_name": {
      "description": "Name of an entry in the the runner service catalog (postgres, redis, ...).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,38}$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64
        },
        "disk_mb": {
          "type": "integer",
          "minimum": 64
        },
        "wall_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "pids": {
          "type": "integer",
          "minimum": 16
        }
      },
      "additionalProperties": false
    },
    "generic": {
      "type": "object",
      "properties": {
        "spec_version": {
          "$ref": "common.schema.json#/$defs/spec_version"
        },
        "layer": {
          "const": "generic"
        },
        "profile": {
          "$ref": "common.schema.json#/$defs/profile_kind"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/short_text"
        },
        "weight": {
          "description": "Scheduler lane: light and heavy runs are capped and interleaved separately (heijunka).",
          "enum": [
            "light",
            "heavy"
          ]
        },
        "isolation": {
          "$ref": "common.schema.json#/$defs/isolation"
        },
        "image": {
          "description": "Required unless isolation is 'vm' (then forbidden): the OCI image the run starts from.",
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/image_ref"
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        "toolchain_manifest": {
          "$ref": "#/$defs/toolchain_manifest"
        },
        "prompt": {
          "$ref": "#/$defs/file_ref"
        },
        "branch_prefix": {
          "description": "Mandatory prefix of any branch this profile may push, ending in '/'.",
          "type": "string",
          "pattern": "^(?![-/.])[A-Za-z0-9._-]{0,39}[A-Za-z0-9_]/$"
        },
        "network": {
          "type": "object",
          "properties": {
            "enforcement": {
              "description": "'log-only' records what would be denied (the first-week mode); 'deny' is default-deny.",
              "enum": [
                "deny",
                "log-only"
              ]
            },
            "allow": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/host_rule"
              }
            }
          },
          "required": [
            "enforcement",
            "allow"
          ],
          "additionalProperties": false
        },
        "ops": {
          "type": "object",
          "properties": {
            "allow": {
              "description": "Upper bound of ops a run of this profile can ever hold. Policy may grant fewer.",
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/op_kind_pattern"
              }
            }
          },
          "required": [
            "allow"
          ],
          "additionalProperties": false
        },
        "services": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/service_name"
              }
            }
          },
          "required": [
            "allow"
          ],
          "additionalProperties": false
        },
        "limits": {
          "allOf": [
            {
              "$ref": "#/$defs/limits"
            },
            {
              "type": "object",
              "required": [
                "cpus",
                "memory_mb",
                "disk_mb",
                "wall_minutes"
              ]
            }
          ]
        }
      },
      "required": [
        "spec_version",
        "layer",
        "profile",
        "version",
        "summary",
        "weight",
        "isolation",
        "prompt",
        "network",
        "ops",
        "services",
        "limits"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "isolation": {
            "const": "vm"
          }
        },
        "required": [
          "isolation"
        ]
      },
      "then": {
        "description": "T0: the toolchain is the VM's verified manifest; there is no OCI image.",
        "required": [
          "toolchain_manifest"
        ],
        "properties": {
          "image": false
        }
      },
      "else": {
        "description": "Every other tier starts from an OCI image pinned by digest.",
        "required": [
          "image"
        ],
        "properties": {
          "toolchain_manifest": false
        }
      }
    },
    "overlay": {
      "type": "object",
      "properties": {
        "spec_version": {
          "$ref": "common.schema.json#/$defs/spec_version"
        },
        "layer": {
          "const": "overlay"
        },
        "project": {
          "$ref": "common.schema.json#/$defs/project_id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "extends": {
          "description": "The one generic profile this overlays, pinned to an exact version and to the digest of that version's signed artifact (a re-published version with new contents must not match).",
          "type": "object",
          "properties": {
            "profile": {
              "$ref": "common.schema.json#/$defs/profile_kind"
            },
            "version": {
              "$ref": "common.schema.json#/$defs/semver"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "profile",
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "toolchain": {
          "description": "Per-project toolchain image layered on the generic base.",
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "ref": {
                  "$ref": "#/$defs/image_ref"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false
        },
        "prompt_addendum": {
          "$ref": "#/$defs/file_ref"
        },
        "network": {
          "type": "object",
          "properties": {
            "allow_add": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/host_rule"
              }
            }
          },
          "required": [
            "allow_add"
          ],
          "additionalProperties": false
        },
        "ops": {
          "description": "May only narrow: every entry must already be covered by the generic profile's ops.allow (checked at merge time, not by this schema).",
          "type": "object",
          "properties": {
            "narrow_to": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/op_kind_pattern"
              }
            }
          },
          "required": [
            "narrow_to"
          ],
          "additionalProperties": false
        },
        "services": {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/service_name"
              }
            }
          },
          "required": [
            "add"
          ],
          "additionalProperties": false
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "spec_version",
        "layer",
        "project",
        "version",
        "extends"
      ],
      "additionalProperties": false
    }
  }
}
